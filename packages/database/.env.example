# Copy to .env and fill in real values. Never commit the real .env file.
# Used by: npm run migrate|backup|restore --workspace=@ui-quality/database

# --- Required ---
DATABASE_URL=postgres://uiquality:uiquality_dev@localhost:5432/uiquality_dev
# Reserved for a future MongoDB repository adapter; currently unused.
MONGODB_URI=mongodb://localhost:27017/uiquality_dev

# --- Backup destination (optional — local filesystem is the default) ---
# Leave BACKUP_S3_BUCKET unset to write backups to BACKUP_STORAGE_ROOT_DIR
# (or STORAGE_ROOT_DIR, or ./data/storage) on local disk. Set it to
# switch to S3 instead — NOTE: S3ObjectStorage is a documented,
# reviewed-but-not-yet-implemented stub (see
# packages/storage/src/s3-adapter.ts); setting BACKUP_S3_BUCKET without
# finishing that implementation will fail fast and loudly, which is the
# intended behavior — better than silently backing up nowhere durable.
BACKUP_STORAGE_ROOT_DIR=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ENDPOINT=              # for S3-compatible providers (R2, MinIO); omit for real AWS S3

# --- Retention ---
BACKUP_RETENTION_DAYS=30         # backups older than this are deleted after each successful new backup

# --- Required only if BACKUP_STORAGE_ROOT_DIR points at the local adapter ---
STORAGE_SIGNING_SECRET=          # generate: openssl rand -hex 32 (only used for URL signing elsewhere; harmless if unset here)
