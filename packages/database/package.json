{
  "name": "@ui-quality/database",
  "version": "0.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/migrations && cp -r ../../packages/database/migrations/*.sql dist/migrations/",
    "migrate": "tsx src/migrate.ts",
    "backup": "tsx src/backup.ts",
    "restore": "tsx src/restore.ts"
  },
  "dependencies": {
    "pg": "^8.13.0",
    "@ui-quality/storage": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.16.5"
  }
}
