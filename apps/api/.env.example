# Copy to .env and fill in real values. Never commit the real .env file.

# --- Required ---
DATABASE_URL=postgres://uiquality:uiquality_dev@localhost:5432/uiquality_dev
# Optional MongoDB connection string for a future Mongo-backed adapter.
# The current API/database repositories use PostgreSQL via DATABASE_URL.
MONGODB_URI=mongodb://localhost:27017/uiquality_dev
MONGODB_DB_NAME=uiVision
MONGODB_USERS_COLLECTION=signIn
AUTH_STORE=postgres                 # set to mongo to use MongoDB for auth
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=                      # generate: openssl rand -hex 32
STORAGE_SIGNING_SECRET=          # generate: openssl rand -hex 32

# --- Optional (sensible defaults in code) ---
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
STORAGE_ROOT_DIR=./data/storage
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/evidence
LOG_LEVEL=info
LOG_PRETTY=1                     # human-readable logs for local dev; unset in prod

# --- AI (optional — omit to run with --ai off / mock only) ---
ANTHROPIC_API_KEY=
