# Copy to .env and fill in real values. Never commit the real .env file.
# Must match the API's DATABASE_URL / REDIS_URL / STORAGE_SIGNING_SECRET —
# the worker and API share the same database, queue, and signing secret.

# --- Required ---
DATABASE_URL=postgres://uiquality:uiquality_dev@localhost:5432/uiquality_dev
REDIS_URL=redis://127.0.0.1:6379
STORAGE_SIGNING_SECRET=          # must match apps/api's value

# --- Optional (sensible defaults in code) ---
STORAGE_ROOT_DIR=./data/storage
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/evidence
WORKER_CONCURRENCY=2
METRICS_PORT=9090
LOG_LEVEL=info
LOG_PRETTY=1

# Path to a real Chromium/Chrome binary. Leave unset if `npx playwright
# install chromium` succeeded in this environment.
UI_SCAN_CHROMIUM_PATH=

# --- AI (optional) ---
ANTHROPIC_API_KEY=
